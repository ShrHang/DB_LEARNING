{
  "name": "questionnaire-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:start": "node scripts/mongo-local.js start",
    "db:stop": "node scripts/mongo-local.js stop",
    "db:status": "node scripts/mongo-local.js status",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "test:unit": "node --test --test-isolation=none tests/unit/*.test.js",
    "test:integration": "node --test --test-isolation=none --test-concurrency=1 tests/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:browser": "node --test --test-isolation=none --test-concurrency=1 tests/browser/*.test.js"
  },
  "dependencies": {
    "connect-mongo": "6.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}
